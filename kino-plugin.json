{
  "id": "cinejoy",
  "name": "CineJoy",
  "version": "1.0.9",
  "apiVersion": 20,
  "entry": "plugin.js",
  "description": "Películas y series en alta calidad de Cinejoy, con portada y estrenos",
  "author": "cinejoy",
  "homepage": "https://cinejoy.pk",
  "hosts": [
    "api.themoviedb.org",
    "image.tmdb.org",
    "cinejoy.pk",
    "cinejoy.to",
    "api.wing.st",
    "api2.wing.st",
    "lists.wing.st",
    "subs2.wing.st",
    "streamdata.vaplayer.ru",
    "brightpathsignals.com",
    "cinejoyproxy.lenoxlkzsdy.workers.dev"
  ],
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "episodes",
    "resolve",
    "screen",
    "download",
    "nuvio"
  ],
  "screen": {
    "label": "CineJoy"
  },
  "color": "#95FF50",
  "icon": "icon.png",
  "settings": [
    {
      "key": "server",
      "label": "Servidor preferido",
      "type": "select",
      "options": [
        {
          "value": "auto",
          "label": "Automático (Mejor disponible)"
        },
        {
          "value": "Light",
          "label": "Light (4K Ultra HD + Subtítulos)"
        },
        {
          "value": "Sirius",
          "label": "Sirius (4K Ultra HD)"
        },
        {
          "value": "Paris",
          "label": "Paris (HD · Películas)"
        },
        {
          "value": "Polaris",
          "label": "Polaris (1080p Full HD)"
        },
        {
          "value": "Nebula",
          "label": "Nebula (1080p)"
        }
      ],
      "default": "auto",
      "hint": "Servidor principal para reproducir películas y capítulos"
    },
    {
      "key": "hls_proxy",
      "label": "Proxy HLS (ExoPlayer Fix)",
      "type": "toggle",
      "default": true,
      "hint": "Corrige cabeceras MIME y Referer para reproducir HLS sin errores en Android"
    },
    {
      "key": "quality",
      "label": "Calidad de video preferida",
      "type": "select",
      "options": [
        {
          "value": "auto",
          "label": "Automática"
        },
        {
          "value": "1080",
          "label": "1080p Full HD"
        },
        {
          "value": "720",
          "label": "720p HD"
        },
        {
          "value": "2160",
          "label": "4K Ultra HD"
        }
      ],
      "default": "auto",
      "hint": "Resolución preferida al cargar el reproductor"
    },
    {
      "key": "lang",
      "label": "Idioma de subtítulos",
      "type": "select",
      "options": [
        {
          "value": "es",
          "label": "Español (Latino / Castellano)"
        },
        {
          "value": "en",
          "label": "Inglés"
        },
        {
          "value": "none",
          "label": "Desactivados"
        }
      ],
      "default": "es",
      "hint": "Selecciona el idioma preferido de subtítulos por defecto"
    },
    {
      "key": "nuvio_priority",
      "label": "Scrapers de Nuvio preferidos",
      "type": "select",
      "options": [
        {
          "value": "auto",
          "label": "Automático (Español y más rápidos)"
        },
        {
          "value": "es",
          "label": "Priorizar fuentes en Español"
        },
        {
          "value": "all",
          "label": "Todos los scrapers compatibles"
        }
      ],
      "default": "auto",
      "hint": "Orden de consulta para los scrapers de Nuvio"
    }
  ],
  "nuvioRepos": [
    "NuvioPlugin/All-in-One-Nuvio",
    "SA7ANI/cb-providers"
  ],
  "recommends": [
    "kinotvapp/kino-social"
  ],
  "consumes": {
    "social": {
      "repo": "kinotvapp/kino-social",
      "door": "wall",
      "calls": [
        "share"
      ]
    }
  }
}